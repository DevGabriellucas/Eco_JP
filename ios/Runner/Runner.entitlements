<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Attest: o App Check em release usa
	     AppleAppAttestWithDeviceCheckFallbackProvider (lib/main.dart). A
	     capability "App Attest" também precisa estar ligada no App ID
	     br.com.ecojp.app no Apple Developer. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
